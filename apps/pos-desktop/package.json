{
  "name": "@pos/pos-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && electron-rebuild -f -w better-sqlite3 && electron-builder --dir",
    "package": "tsc -p tsconfig.json && vite build && electron-rebuild -f -w better-sqlite3 && electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "electron-updater": "^6.3.9",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@pos/business-logic": "workspace:*",
    "@pos/database": "workspace:*",
    "@pos/types": "workspace:*",
    "@pos/validation": "workspace:*",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "bcryptjs": "^2.4.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "build": {
    "appId": "com.supermarketpos.desktop",
    "productName": "Supermarket POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "npmRebuild": false,
    "extraResources": [],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}
