{
  "name": "supermarket-pos",
  "private": true,
  "version": "0.1.0",
  "description": "Supermarket POS — Electron + React + TypeScript, offline-first billing.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "pnpm rebuild:electron && vite",
    "build": "tsc --noEmit && vite build && electron-rebuild -f -w better-sqlite3 && electron-builder --dir",
    "package": "tsc --noEmit && vite build && electron-rebuild -f -w better-sqlite3 && electron-builder",
    "test": "pnpm rebuild:node && vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "migrate": "vite-node --config vitest.config.mts src/core/database/migrate-cli.ts --",
    "seed:catalog": "vite-node --config vitest.config.mts src/core/database/seed-catalog-cli.ts --",
    "seed:kirana": "vite-node --config vitest.config.mts src/core/database/seed-kirana-catalog-cli.ts --",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "check:extensions": "node scripts/proof/check-extensions.mjs",
    "proof": "node scripts/proof/run.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@eslint/js": "^9.15.0",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "bcryptjs": "^2.4.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fuse.js": "^7.0.0",
    "husky": "^9.1.6",
    "jsdom": "^25",
    "kysely": "^0.27.4",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "uuid": "^9.0.1",
    "vite": "^5.4.11",
    "vite-node": "2.1.9",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.supermarketpos.desktop",
    "productName": "Supermarket POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "npmRebuild": false,
    "extraResources": [],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}
